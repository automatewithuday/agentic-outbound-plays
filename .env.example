# GetLeads API key (app.getleads.io/api-keys)
GETLEADS_API_KEY=
# Deepline API key (the CLI also supports its own login)
DEEPLINE_API_KEY=
# Apify API token (console.apify.com)
APIFY_API_TOKEN=
# Smartlead API key (email sending)
SMARTLEAD_API_KEY=
# HeyReach: only needed for the direct push (outbound/push_heyreach.py). The GetLeads MCP route needs no key here.
HEYREACH_API_KEY=
# optional — Play 2 social intent via Log by ListeningKit (self-host or log.listeningkit.com)
LISTENINGKIT_API_KEY=
LISTENINGKIT_BASE_URL=https://log.listeningkit.com
# optional — only if you choose the ColdIQ path described in README
# COLDIQ_API_KEY=
